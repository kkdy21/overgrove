          "io.github.kkdy21.overgrove": {
            "swiftui": "Font.title3.weight(.semibold)"
          }
        }
      },
      "callout": { "$value": { "fontFamily": "SF Pro", "fontSize": "12px", "fontWeight": 400, "lineHeight": 1.25 }, "$extensions": { "io.github.kkdy21.overgrove": { "swiftui": "Font.callout" } } },
      "caption": {
        "$value": {
          "fontFamily": "SF Pro",
          "fontSize": "10px",
          "fontWeight": 400,
          "lineHeight": 1.2
        },
        "$description": "Status bar and sidebar section headers",
        "$extensions": {
          "io.github.kkdy21.overgrove": {
            "swiftui": "Font.caption"
          }
        }
      },
      "section-header": {
        "$value": {
          "fontFamily": "SF Pro",
