      "graph-node": { "$value": "22px", "$description": "Commit node outer diameter: 17px avatar + 2.5px lane ring." },
      "graph-node-merge": { "$value": "10px", "$description": "Merge commit node: small solid dot in the lane color, no avatar." },
      "graph-node-head": { "$value": "30px", "$description": "Outer diameter of the head ring around the focused worktree's HEAD node." },
      "graph-edge": { "$value": "3px" },
      "graph-node-ring": { "$value": "2.5px" },
