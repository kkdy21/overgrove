            "swiftui": "Font.system(.callout, design: .monospaced)"
          }
        }
      },
      "mono-small": {
        "$value": {
          "fontFamily": "SF Mono",
          "fontSize": "11px",
          "fontWeight": 400,
          "lineHeight": 1.3
        },
