{
  "$description": "Overgrove design tokens (W3C Design Tokens Community Group format). $value is the light-mode value; the dark-mode value lives in $extensions[\"io.github.kkdy21.overgrove\"].modes.dark, and the Increase Contrast values in modes[\"high-contrast\"] (falls back to $value) and modes[\"dark-high-contrast\"] (falls back to dark, then $value). An alias resolves in the mode being resolved. Tokens that should resolve to a macOS system color at runtime name it in $extensions[...].appkit; the hex value is a fallback for docs and mockups only. See docs/design/design-tokens.md.",
  "primitive": {
    "color": {
      "$type": "color",
      "forest": {
        "$description": "Brand greens taken from the app icon. 400 and 700 are the UI accent steps (dark and light); the rest are for the icon and README mark. Not used for status or graph lanes.",
        "950": { "$value": "#0b2e1f", "$description": "Icon background, bottom" },
        "800": { "$value": "#22603d", "$description": "Icon background, top" },
        "700": { "$value": "#0e764a", "$description": "UI accent on light surfaces" },
        "600": { "$value": "#2c8350", "$description": "Main canopy, shade" },
        "500": { "$value": "#3a9a5c", "$description": "Monochrome mark" },
        "400": { "$value": "#43d59a", "$description": "UI accent on dark surfaces" },
        "300": { "$value": "#8fdcaa", "$description": "Main canopy, light" },
        "200": { "$value": "#b9ec95", "$description": "Worktree canopy, light" },
        "100": { "$value": "#ecf7a6", "$description": "Worktree canopy, light (yellow-green)" },
        "cream": { "$value": "#fbf6e6", "$description": "Icon branch line and nodes" }
      },
      "slate": {
        "$description": "Cool neutral ramp (OKLCH hue 262) for every panel surface, border, and text color in both modes. Larger step = darker. Text steps: 125/300/400 on dark, 850/600/500 on light; see docs/design/design-tokens.md §5.",
        "0": { "$value": "#ffffff" },
        "25": { "$value": "#f9fafc" },
        "50": { "$value": "#f3f5f9" },
        "100": { "$value": "#eef0f4" },
        "125": { "$value": "#e7eaef" },
        "150": { "$value": "#e3e6ec" },
        "200": { "$value": "#d5d9e1" },
        "300": { "$value": "#b0b6c0" },
        "350": { "$value": "#9399a2" },
        "400": { "$value": "#888e99" },
        "500": { "$value": "#666c78" },
        "550": { "$value": "#5e636e" },
        "600": { "$value": "#4a505b" },
        "700": { "$value": "#3d434c" },
        "750": { "$value": "#2b303a" },
        "800": { "$value": "#21252e" },
        "825": { "$value": "#1d2229" },
        "850": { "$value": "#191d24" },
        "900": { "$value": "#14181e" },
        "950": { "$value": "#0e1116" }
      },
      "status": {
        "$description": "Status steps. Validated against the panel theme surfaces (canvas, panel, raised) in both modes; see docs/design/design-tokens.md §5. The 700 (light) and 300 (dark) steps are the Increase Contrast variants: same OKLCH hue, lightness moved until every panel surface including surface.selection reaches 4.5:1.",
        "green-700": { "$value": "#1c7528", "$description": "Increase Contrast, light" },
        "green-600": { "$value": "#267d30" },
        "green-400": { "$value": "#68d36f" },
        "amber-700": { "$value": "#9a5401", "$description": "Increase Contrast, light" },
        "amber-600": { "$value": "#a95f0e" },
        "amber-400": { "$value": "#fcb442" },
        "crimson-700": { "$value": "#c31d5e", "$description": "Increase Contrast, light" },
        "crimson-600": { "$value": "#c41f5f" },
        "crimson-400": { "$value": "#f3597c" },
        "crimson-300": { "$value": "#fc6183", "$description": "Increase Contrast, dark" },
        "blue-700": { "$value": "#1c66b9", "$description": "Increase Contrast, light" },
        "blue-600": { "$value": "#1f68bc" },
        "blue-400": { "$value": "#6fb2fc" },
        "neutral-700": { "$value": "#626670", "$description": "Increase Contrast, light" },
        "neutral-600": { "$value": "#818690" },
        "neutral-400": { "$value": "#878c96" },
        "neutral-300": { "$value": "#9297a1", "$description": "Increase Contrast, dark" }
      },
      "lane": {
        "$description": "Lane hue families (8), each with a light-mode and a dark-mode step. Vivid, high-chroma steps chosen in OKLCH per hue; the semantic order puts far-apart hues next to each other. Original palette, not taken from another product; see docs/design/art-direction.md §4. The -hc steps are the Increase Contrast variants (4.5:1 on every panel surface); families without one already pass.",
        "azure-light": { "$value": "#0e71b0" },
        "azure-light-hc": { "$value": "#016aa8" },
        "azure-dark": { "$value": "#43acfc" },
        "jade-light": { "$value": "#15945e" },
        "jade-light-hc": { "$value": "#027548" },
        "jade-dark": { "$value": "#25df90" },
        "violet-light": { "$value": "#7d2fc8" },
        "violet-dark": { "$value": "#b074fb" },
        "violet-dark-hc": { "$value": "#b47aff" },
        "coral-light": { "$value": "#d7152c" },
        "coral-light-hc": { "$value": "#cd0225" },
        "coral-dark": { "$value": "#fc6764" },
        "aqua-light": { "$value": "#148b90" },
        "aqua-light-hc": { "$value": "#037175" },
        "aqua-dark": { "$value": "#27dee6" },
        "amber-light": { "$value": "#bf7012" },
        "amber-light-hc": { "$value": "#975602" },
        "amber-dark": { "$value": "#fda858" },
        "magenta-light": { "$value": "#bf1e94" },
        "magenta-light-hc": { "$value": "#bb1790" },
        "magenta-dark": { "$value": "#f75cc7" },
        "yellow-light": { "$value": "#a59316" },
        "yellow-light-hc": { "$value": "#736603" },
        "yellow-dark": { "$value": "#f7dc27" }
      },
      "diff": {
        "$description": "Diff backgrounds: the status color blended over the canvas (bg 13%/10%, word 30%/24%, hunk header 12%/8%, dark/light).",
        "added-bg-light": { "$value": "#e9f2ea" },
        "added-bg-dark": { "$value": "#1f3029" },
        "removed-bg-light": { "$value": "#f9e9ef" },
        "removed-bg-dark": { "$value": "#31202a" },
        "added-word-light": { "$value": "#cbe0cd" },
        "added-word-dark": { "$value": "#2d5036" },
        "removed-word-light": { "$value": "#f1c9d9" },
        "removed-word-dark": { "$value": "#572b3a" },
        "hunk-bg-light": { "$value": "#edf3fa" },
        "hunk-bg-dark": { "$value": "#1f2a39" }
      },
      "system-fallback": {
        "$description": "Approximate sRGB values of macOS-drawn chrome (window buttons), for docs and mockups only. Native controls (menus, popovers, sheets, the Settings window) keep their system colors at runtime.",
        "window-close": { "$value": "#ff5f57", "$description": "Window chrome drawn by the system. Mockups only; app code never references these." },
        "window-minimize": { "$value": "#febc2e" },
        "window-zoom": { "$value": "#28c840" }
      },
      "avatar": {
        "$description": "Initials avatar fills (8). Same value in light and dark so a person keeps one color across themes. Each passes 4.5:1 against the white initials; see docs/design/design-tokens.md §5.4.",
        "green": { "$value": "#1d7a4a" },
        "blue": { "$value": "#2f67c8" },
        "red": { "$value": "#c62f3e" },
        "violet": { "$value": "#7048c8" },
        "orange": { "$value": "#b04f00" },
        "teal": { "$value": "#00778f" },
        "gold": { "$value": "#8a6a00" },
        "magenta": { "$value": "#a8389a" },
        "initials": { "$value": "#ffffff" }
      }
    }
  },
  "semantic": {
    "color": {
      "$type": "color",
      "surface": {
        "$description": "Panel theme surfaces (art-direction.md §2). The window is a dark gutter; the sidebar, graph, and detail are separate rounded panels on it.",
        "window": {
          "$value": "{primitive.color.slate.150}",
          "$description": "Window background behind the panels: toolbar, gutters between panels, status bar.",
          "$extensions": {
            "io.github.kkdy21.overgrove": {
              "modes": {
                "dark": "{primitive.color.slate.950}"
              }
            }
          }
        },
        "canvas": {
          "$value": "{primitive.color.slate.0}",
          "$description": "Graph panel body and the diff viewer. Lane, status, and pill contrast is validated against this.",
          "$extensions": {
            "io.github.kkdy21.overgrove": {
              "modes": {
                "dark": "{primitive.color.slate.900}"
              }
            }
          }
        },
        "panel": { "$value": "{primitive.color.slate.25}", "$description": "Sidebar and detail panel bodies.", "$extensions": { "io.github.kkdy21.overgrove": { "modes": { "dark": "{primitive.color.slate.850}" } } } },
        "panel-header": { "$value": "{primitive.color.slate.50}", "$description": "Panel header strip and the graph column header row.", "$extensions": { "io.github.kkdy21.overgrove": { "modes": { "dark": "{primitive.color.slate.825}" } } } },
        "raised": {
          "$value": "{primitive.color.slate.100}",
          "$description": "Cards inside a panel (file groups, metadata blocks, the focused worktree row).",
          "$extensions": {
            "io.github.kkdy21.overgrove": {
              "modes": {
                "dark": "{primitive.color.slate.800}"
              }
            }
          }
        },
        "panel-highlight": { "$value": "#ffffff00", "$description": "1px inner highlight along the top edge of each panel in dark mode (white 3.5%, art-direction.md §3). Transparent in light mode, which uses surface.panel-shadow instead.", "$extensions": { "io.github.kkdy21.overgrove": { "modes": { "dark": "#ffffff09" } } } },
        "panel-shadow": { "$value": "#0000000d", "$description": "1px shadow below each panel in light mode (black 5%, offset 1px, no blur; art-direction.md §3). Transparent in dark mode, which uses surface.panel-highlight instead.", "$extensions": { "io.github.kkdy21.overgrove": { "modes": { "dark": "#00000000" } } } },
        "hover": { "$value": "#1a1f2a0a", "$description": "Row under the pointer. Blended over whatever surface is below.", "$extensions": { "io.github.kkdy21.overgrove": { "modes": { "dark": "#ffffff0b" } } } },
        "selection": {
          "$value": "#dee7f4",
          "$description": "Selected row in the focused panel (sidebar and detail lists). Graph rows use the lane tint instead (graph.selection-opacity). Tertiary text on it switches to text.secondary.",
          "$extensions": {
            "io.github.kkdy21.overgrove": {
              "modes": {
                "dark": "#252f3c"
              }
            }
          }
        },
        "selection-inactive": { "$value": "{primitive.color.slate.100}", "$description": "Selected row in an unfocused panel.", "$extensions": { "io.github.kkdy21.overgrove": { "modes": { "dark": "{primitive.color.slate.800}" } } } },
        "control": {
          "$value": "#ffffff",
          "$description": "Chips, segmented controls, and toolbar fields drawn inside panels. Light mode adds a border.separator outline.",
          "$extensions": {
            "io.github.kkdy21.overgrove": {
              "modes": {
                "dark": "#ffffff0f"
              }
            }
          }
        },
        "wip-row": {
          "$value": "#0e764a12",
          "$description": "WIP row background: accent at 7% (light) / 9% (dark). The one semantic color with alpha baked in, because it is always drawn over the canvas.",
          "$extensions": {
            "io.github.kkdy21.overgrove": {
              "modes": {
                "dark": "#43d59a17"
              }
            }
          }
        },
        "splitter-grip": {
          "$value": "{primitive.color.slate.500}",
          "$description": "Grip mark (4×28 capsule) centred in the gutter between two panels. ≥ 3:1 against surface.window so the handle is visible before hover.",
          "$extensions": {
            "io.github.kkdy21.overgrove": {
              "modes": {
                "dark": "{primitive.color.slate.500}"
              }
            }
          }
        },
        "splitter-grip-active": { "$value": "{semantic.color.accent}", "$description": "Grip while hovered or dragged; the gutter also gets the accent at 10% (art-direction.md §3.2, ADR-0014)." },
        "scrollbar-thumb": { "$value": "#1a1f2a3d", "$description": "Overlay scrollbar thumb inside a panel.", "$extensions": { "io.github.kkdy21.overgrove": { "modes": { "dark": "#ffffff33" } } } }
      },
      "text": {
        "primary": { "$value": "{primitive.color.slate.850}", "$description": "Titles, file names, commit subjects.", "$extensions": { "io.github.kkdy21.overgrove": { "modes": { "dark": "{primitive.color.slate.125}" } } } },
        "secondary": { "$value": "{primitive.color.slate.600}", "$description": "Metadata: author, relative date, path prefixes, counts.", "$extensions": { "io.github.kkdy21.overgrove": { "modes": { "dark": "{primitive.color.slate.300}" } } } },
        "tertiary": {
          "$value": "{primitive.color.slate.500}",
          "$description": "Low-emphasis metadata (SHA, timestamps, path tails, column headers). Passes 4.5:1 on every panel surface; on surface.selection use text.secondary.",
          "$extensions": {
            "io.github.kkdy21.overgrove": {
              "modes": {
                "dark": "{primitive.color.slate.400}",
                "high-contrast": "{semantic.color.text.secondary}",
                "dark-high-contrast": "{semantic.color.text.secondary}"
              }
            }
          }
        },
        "quaternary": {
          "$value": "{primitive.color.slate.350}",
          "$description": "Placeholder and disabled text only. Never for information the user needs.",
          "$extensions": {
            "io.github.kkdy21.overgrove": {
              "modes": {
                "dark": "{primitive.color.slate.550}"
              }
            }
          }
        },
        "on-accent": { "$value": "#ffffff", "$description": "Text and glyphs on an accent fill (selected chip, primary button).", "$extensions": { "io.github.kkdy21.overgrove": { "modes": { "dark": "{primitive.color.slate.950}" } } } },
        "link": { "$value": "{primitive.color.status.blue-600}", "$extensions": { "io.github.kkdy21.overgrove": { "modes": { "dark": "{primitive.color.status.blue-400}" } } } }
      },
      "border": {
        "panel": {
          "$value": "{primitive.color.slate.200}",
          "$description": "1px outline of each panel. Under Increase Contrast use border.strong.",
          "$extensions": {
            "io.github.kkdy21.overgrove": {
              "modes": {
                "dark": "{primitive.color.slate.750}",
                "high-contrast": "{semantic.color.border.strong}",
                "dark-high-contrast": "{semantic.color.border.strong}"
              }
            }
          }
        },
        "separator": { "$value": "{primitive.color.slate.150}", "$description": "Dividers inside a panel (header bottom, between groups).", "$extensions": { "io.github.kkdy21.overgrove": { "modes": { "dark": "{primitive.color.slate.800}" } } } },
        "strong": { "$value": "{primitive.color.slate.300}", "$description": "Control outlines and the panel outline under Increase Contrast.", "$extensions": { "io.github.kkdy21.overgrove": { "modes": { "dark": "{primitive.color.slate.700}" } } } },
        "focus": { "$value": "{semantic.color.accent}", "$description": "Keyboard focus ring.", "$extensions": { "io.github.kkdy21.overgrove": { "appkit": "NSColor.keyboardFocusIndicatorColor (follows the user accent if one is set)" } } }
      },
      "accent": {
        "$value": "{primitive.color.forest.700}",
        "$description": "Interactive emphasis: focus ring, HEAD ring, selected chip, primary button, active splitter grip. Set as the app AccentColor, so a user who picked a system accent color (not Multicolor) still gets theirs.",
        "$extensions": {
          "io.github.kkdy21.overgrove": {
            "modes": {
              "dark": "{primitive.color.forest.400}"
            },
            "appkit": "AccentColor asset → NSColor.controlAccentColor"
          }
        }
      },
      "status": {
        "$description": "Reserved state colors. Always paired with an SF Symbol and a text label (docs/design/iconography.md §5). Never reused for graph lanes or decoration.",
        "staged": { "$value": "{primitive.color.status.green-600}", "$extensions": { "io.github.kkdy21.overgrove": { "modes": { "dark": "{primitive.color.status.green-400}", "high-contrast": "{primitive.color.status.green-700}" } } } },
        "unstaged": { "$value": "{primitive.color.status.amber-600}", "$extensions": { "io.github.kkdy21.overgrove": { "modes": { "dark": "{primitive.color.status.amber-400}", "high-contrast": "{primitive.color.status.amber-700}" } } } },
        "untracked": { "$value": "{primitive.color.status.neutral-600}", "$extensions": { "io.github.kkdy21.overgrove": { "modes": { "dark": "{primitive.color.status.neutral-400}", "high-contrast": "{primitive.color.status.neutral-700}", "dark-high-contrast": "{primitive.color.status.neutral-300}" } } } },
        "conflicted": { "$value": "{primitive.color.status.crimson-600}", "$extensions": { "io.github.kkdy21.overgrove": { "modes": { "dark": "{primitive.color.status.crimson-400}", "high-contrast": "{primitive.color.status.crimson-700}", "dark-high-contrast": "{primitive.color.status.crimson-300}" } } } },
        "ahead": {
          "$value": "{primitive.color.status.blue-600}",
          "$description": "Same step as behind on purpose: the arrow direction (↑/↓) is the encoding, the color only says 'differs from upstream'.",
          "$extensions": {
            "io.github.kkdy21.overgrove": {
              "modes": {
                "dark": "{primitive.color.status.blue-400}",
                "high-contrast": "{primitive.color.status.blue-700}"
              }
            }
          }
        },
        "behind": { "$value": "{primitive.color.status.blue-600}", "$description": "Same step as ahead on purpose; see status.ahead.", "$extensions": { "io.github.kkdy21.overgrove": { "modes": { "dark": "{primitive.color.status.blue-400}", "high-contrast": "{primitive.color.status.blue-700}" } } } },
        "locked": { "$value": "{primitive.color.status.neutral-600}", "$extensions": { "io.github.kkdy21.overgrove": { "modes": { "dark": "{primitive.color.status.neutral-400}", "high-contrast": "{primitive.color.status.neutral-700}", "dark-high-contrast": "{primitive.color.status.neutral-300}" } } } },
        "prunable": {
          "$value": "{primitive.color.status.amber-600}",
          "$description": "Warning amber. Shares the unstaged step; the two never appear in the same context (worktree row vs file row).",
          "$extensions": {
            "io.github.kkdy21.overgrove": {
              "modes": {
                "dark": "{primitive.color.status.amber-400}",
                "high-contrast": "{primitive.color.status.amber-700}"
              }
            }
          }
        },
        "ok": {
          "$value": "{primitive.color.status.green-600}",
          "$description": "Security checklist and onboarding checks that passed.",
          "$extensions": {
            "io.github.kkdy21.overgrove": {
              "modes": {
                "dark": "{primitive.color.status.green-400}",
                "high-contrast": "{primitive.color.status.green-700}"
              }
            }
          }
        },
        "warning": {
          "$value": "{primitive.color.status.amber-600}",
          "$description": "Onboarding and security checks that need attention, auth warnings.",
          "$extensions": {
            "io.github.kkdy21.overgrove": {
              "modes": {
                "dark": "{primitive.color.status.amber-400}",
                "high-contrast": "{primitive.color.status.amber-700}"
              }
            }
          }
        },
        "error": { "$value": "{primitive.color.status.crimson-600}", "$description": "Failed commands, timeouts, checks that failed.", "$extensions": { "io.github.kkdy21.overgrove": { "modes": { "dark": "{primitive.color.status.crimson-400}", "high-contrast": "{primitive.color.status.crimson-700}", "dark-high-contrast": "{primitive.color.status.crimson-300}" } } } }
      },
      "on-status": {
        "$description": "Letter or glyph on a solid status fill (file kind badges A/M/D/R/U/?). Whichever of white / slate.950 has the higher contrast; every pair is ≥ 4.5:1.",
        "staged": { "$value": "#ffffff", "$extensions": { "io.github.kkdy21.overgrove": { "modes": { "dark": "{primitive.color.slate.950}" } } } },
        "unstaged": { "$value": "#ffffff", "$extensions": { "io.github.kkdy21.overgrove": { "modes": { "dark": "{primitive.color.slate.950}" } } } },
        "untracked": { "$value": "{primitive.color.slate.950}", "$extensions": { "io.github.kkdy21.overgrove": { "modes": { "dark": "{primitive.color.slate.950}", "high-contrast": "#ffffff" } } } },
        "conflicted": { "$value": "#ffffff", "$extensions": { "io.github.kkdy21.overgrove": { "modes": { "dark": "{primitive.color.slate.950}" } } } },
        "ahead": { "$value": "#ffffff", "$extensions": { "io.github.kkdy21.overgrove": { "modes": { "dark": "{primitive.color.slate.950}" } } } }
      },
      "graph": {
        "lane": {
          "$description": "Lane colors in fixed cyclic order. Lane color index = lane column index mod 8, fixed when a lane is born (ADR-0010). The order alternates far-apart hues so neighbouring lanes never look alike.",
          "0": { "$value": "{primitive.color.lane.azure-light}", "$extensions": { "io.github.kkdy21.overgrove": { "modes": { "dark": "{primitive.color.lane.azure-dark}", "high-contrast": "{primitive.color.lane.azure-light-hc}" } } } },
          "1": { "$value": "{primitive.color.lane.jade-light}", "$extensions": { "io.github.kkdy21.overgrove": { "modes": { "dark": "{primitive.color.lane.jade-dark}", "high-contrast": "{primitive.color.lane.jade-light-hc}" } } } },
          "2": { "$value": "{primitive.color.lane.violet-light}", "$extensions": { "io.github.kkdy21.overgrove": { "modes": { "dark": "{primitive.color.lane.violet-dark}", "high-contrast": "{primitive.color.lane.violet-light}", "dark-high-contrast": "{primitive.color.lane.violet-dark-hc}" } } } },
          "3": { "$value": "{primitive.color.lane.coral-light}", "$extensions": { "io.github.kkdy21.overgrove": { "modes": { "dark": "{primitive.color.lane.coral-dark}", "high-contrast": "{primitive.color.lane.coral-light-hc}" } } } },
          "4": { "$value": "{primitive.color.lane.aqua-light}", "$extensions": { "io.github.kkdy21.overgrove": { "modes": { "dark": "{primitive.color.lane.aqua-dark}", "high-contrast": "{primitive.color.lane.aqua-light-hc}" } } } },
          "5": { "$value": "{primitive.color.lane.amber-light}", "$extensions": { "io.github.kkdy21.overgrove": { "modes": { "dark": "{primitive.color.lane.amber-dark}", "high-contrast": "{primitive.color.lane.amber-light-hc}" } } } },
          "6": { "$value": "{primitive.color.lane.magenta-light}", "$extensions": { "io.github.kkdy21.overgrove": { "modes": { "dark": "{primitive.color.lane.magenta-dark}", "high-contrast": "{primitive.color.lane.magenta-light-hc}" } } } },
          "7": { "$value": "{primitive.color.lane.yellow-light}", "$extensions": { "io.github.kkdy21.overgrove": { "modes": { "dark": "{primitive.color.lane.yellow-dark}", "high-contrast": "{primitive.color.lane.yellow-light-hc}" } } } }
        },
        "on-lane": {
          "$description": "Text and glyph color on a solid lane fill (checked-out branch pill). Whichever of white / slate.950 has the higher contrast; every pair is ≥ 4.5:1 (design-tokens.md §5.1).",
          "0": { "$value": "#ffffff", "$extensions": { "io.github.kkdy21.overgrove": { "modes": { "dark": "{primitive.color.slate.950}" } } } },
          "1": { "$value": "{primitive.color.slate.950}", "$extensions": { "io.github.kkdy21.overgrove": { "modes": { "dark": "{primitive.color.slate.950}", "high-contrast": "#ffffff" } } } },
          "2": { "$value": "#ffffff", "$extensions": { "io.github.kkdy21.overgrove": { "modes": { "dark": "{primitive.color.slate.950}" } } } },
          "3": { "$value": "#ffffff", "$extensions": { "io.github.kkdy21.overgrove": { "modes": { "dark": "{primitive.color.slate.950}" } } } },
          "4": { "$value": "{primitive.color.slate.950}", "$extensions": { "io.github.kkdy21.overgrove": { "modes": { "dark": "{primitive.color.slate.950}", "high-contrast": "#ffffff" } } } },
          "5": { "$value": "{primitive.color.slate.950}", "$extensions": { "io.github.kkdy21.overgrove": { "modes": { "dark": "{primitive.color.slate.950}", "high-contrast": "#ffffff" } } } },
          "6": { "$value": "#ffffff", "$extensions": { "io.github.kkdy21.overgrove": { "modes": { "dark": "{primitive.color.slate.950}" } } } },
          "7": { "$value": "{primitive.color.slate.950}", "$extensions": { "io.github.kkdy21.overgrove": { "modes": { "dark": "{primitive.color.slate.950}", "high-contrast": "#ffffff" } } } }
        },
        "node-ring": { "$value": "{semantic.color.surface.canvas}", "$description": "2px halo in the canvas color around every node so nodes stay separate from edges that pass behind them." },
        "head-ring": { "$value": "{semantic.color.accent}", "$description": "Second ring (2px gap) around the commit checked out in the focused worktree." },
        "wip-node": { "$value": "{semantic.color.text.secondary}", "$description": "Hollow, dashed node for the WIP row. Never takes a lane color, so uncommitted work never looks like a commit." },
        "ref-pill-local-fill-opacity": { "$type": "number", "$value": 0.2, "$description": "Local branch pill = lane color at this opacity + lane-color border (ref-pill-border-opacity), text in text.primary." },
        "ref-pill-border-opacity": { "$type": "number", "$value": 0.75, "$description": "Lane-color border of local and remote pills. Remote pills have no fill." },
        "ref-connector-opacity": { "$type": "number", "$value": 0.55, "$description": "1.5px line in the lane color from a ref pill to its node." },
        "selection-opacity": { "$type": "number", "$value": 0.16, "$description": "Selected graph row = lane color of its node at this opacity over the canvas, plus a 3px lane-color bar at the left edge." },
        "worktree-selection-border-opacity": { "$type": "number", "$value": 0.55, "$description": "Selected WORKTREES row: surface.selection plus a border in its branch's lane color at this opacity (art-direction.md §6)." },
        "focus-chip-fill-opacity": { "$type": "number", "$value": 0.14, "$description": "Toolbar focused-worktree chip: lane color at this opacity over the toolbar background (art-direction.md §3.4)." },
        "focus-chip-border-opacity": { "$type": "number", "$value": 0.45, "$description": "Toolbar focused-worktree chip: border in the lane color at this opacity." }
      },
      "avatar": {
        "$description": "Initials avatar for commit authors (no network avatars). Index = FNV-1a 32-bit hash of the trimmed, lowercased author email, mod 8. Always shown with the name or a tooltip; the color is an identity hint, never the only cue.",
        "0": { "$value": "{primitive.color.avatar.green}", "$extensions": { "io.github.kkdy21.overgrove": { "modes": { "dark": "{primitive.color.avatar.green}" } } } },
        "1": { "$value": "{primitive.color.avatar.blue}", "$extensions": { "io.github.kkdy21.overgrove": { "modes": { "dark": "{primitive.color.avatar.blue}" } } } },
        "2": { "$value": "{primitive.color.avatar.red}", "$extensions": { "io.github.kkdy21.overgrove": { "modes": { "dark": "{primitive.color.avatar.red}" } } } },
        "3": { "$value": "{primitive.color.avatar.violet}", "$extensions": { "io.github.kkdy21.overgrove": { "modes": { "dark": "{primitive.color.avatar.violet}" } } } },
        "4": { "$value": "{primitive.color.avatar.orange}", "$extensions": { "io.github.kkdy21.overgrove": { "modes": { "dark": "{primitive.color.avatar.orange}" } } } },
        "5": { "$value": "{primitive.color.avatar.teal}", "$extensions": { "io.github.kkdy21.overgrove": { "modes": { "dark": "{primitive.color.avatar.teal}" } } } },
        "6": { "$value": "{primitive.color.avatar.gold}", "$extensions": { "io.github.kkdy21.overgrove": { "modes": { "dark": "{primitive.color.avatar.gold}" } } } },
        "7": { "$value": "{primitive.color.avatar.magenta}", "$extensions": { "io.github.kkdy21.overgrove": { "modes": { "dark": "{primitive.color.avatar.magenta}" } } } },
        "initials": { "$value": "{primitive.color.avatar.initials}", "$description": "Initials text on every avatar fill." }
      },
      "diff": {
        "added-bg": { "$value": "{primitive.color.diff.added-bg-light}", "$extensions": { "io.github.kkdy21.overgrove": { "modes": { "dark": "{primitive.color.diff.added-bg-dark}" } } } },
        "removed-bg": { "$value": "{primitive.color.diff.removed-bg-light}", "$extensions": { "io.github.kkdy21.overgrove": { "modes": { "dark": "{primitive.color.diff.removed-bg-dark}" } } } },
        "added-word-bg": { "$value": "{primitive.color.diff.added-word-light}", "$extensions": { "io.github.kkdy21.overgrove": { "modes": { "dark": "{primitive.color.diff.added-word-dark}" } } } },
        "removed-word-bg": { "$value": "{primitive.color.diff.removed-word-light}", "$extensions": { "io.github.kkdy21.overgrove": { "modes": { "dark": "{primitive.color.diff.removed-word-dark}" } } } },
        "hunk-header-bg": { "$value": "{primitive.color.diff.hunk-bg-light}", "$extensions": { "io.github.kkdy21.overgrove": { "modes": { "dark": "{primitive.color.diff.hunk-bg-dark}" } } } },
        "gutter-added": { "$value": "{semantic.color.status.staged}", "$description": "The '+' gutter glyph. The glyph, not the color, carries the meaning." },
        "gutter-removed": { "$value": "{semantic.color.status.conflicted}", "$description": "The '−' gutter glyph." }
      }
    },
