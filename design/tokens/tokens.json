      "pill": { "$value": { "fontFamily": "SF Pro", "fontSize": "11px", "fontWeight": 500, "lineHeight": 1.0 }, "$description": "Ref pills and count chips.", "$extensions": { "io.github.kkdy21.overgrove": { "swiftui": "Font.subheadline.weight(.medium)" } } },
      "initials": { "$value": { "fontFamily": "SF Pro", "fontSize": "8.5px", "fontWeight": 700, "lineHeight": 1.0 }, "$description": "Initials inside graph nodes (17px avatar). 16px avatars elsewhere use 7.5px. The one point-size font: the initials are a glyph sized to a fixed avatar circle, not running text, so no text style fits.", "$extensions": { "io.github.kkdy21.overgrove": { "swiftui": "Font.system(size: 8.5, weight: .bold)" } } },
      "mono": {
        "$value": {
          "fontFamily": "SF Mono",
          "fontSize": "12px",
          "fontWeight": 400,
          "lineHeight": 1.35
        },
        "$description": "SHA, paths in the diff viewer, diff body",
