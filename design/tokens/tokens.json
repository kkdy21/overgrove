{
  "$description": "Overgrove design tokens (W3C Design Tokens Community Group format). $value is the light-mode value; the dark-mode value lives in $extensions[\"io.github.kkdy21.overgrove\"].modes.dark. Tokens that should resolve to a macOS system color at runtime name it in $extensions[...].appkit; the hex value is a fallback for docs and mockups only. See docs/design/design-tokens.md.",
  "primitive": {
    "color": {
      "$type": "color",
      "forest": {
        "$description": "Brand greens taken from the app icon. Not used for status or graph lanes.",
        "950": { "$value": "#0b2e1f", "$description": "Icon background, bottom" },
        "800": { "$value": "#22603d", "$description": "Icon background, top" },
        "600": { "$value": "#2c8350", "$description": "Main canopy, shade" },
        "500": { "$value": "#3a9a5c", "$description": "Monochrome mark" },
        "300": { "$value": "#8fdcaa", "$description": "Main canopy, light" },
        "200": { "$value": "#b9ec95", "$description": "Worktree canopy, light" },
        "100": { "$value": "#ecf7a6", "$description": "Worktree canopy, light (yellow-green)" },
        "cream": { "$value": "#fbf6e6", "$description": "Icon branch line and nodes" }
      },
      "status": {
        "$description": "Status steps. Validated against #ffffff/#ececec (light) and #1e1e1e/#323232 (dark); see docs/design/design-tokens.md §5.",
        "green-600": { "$value": "#0b8a0b" },
        "green-400": { "$value": "#30c048" },
        "amber-600": { "$value": "#b66c18" },
        "amber-400": { "$value": "#f5a524" },
        "crimson-600": { "$value": "#c8175a" },
        "crimson-400": { "$value": "#fb5a8a" },
        "blue-600": { "$value": "#2563c9" },
        "blue-400": { "$value": "#4f9bf0" },
        "neutral-600": { "$value": "#5a5955" },
        "neutral-400": { "$value": "#a19f97" }
      },
      "lane": {
        "$description": "Categorical lane hues (8). Light and dark steps of the same hue family. Source: dataviz reference palette, re-ordered cyclically and validated with the wrap pair.",
        "green-light": { "$value": "#008300" },
        "green-dark": { "$value": "#008300" },
        "blue-light": { "$value": "#2a78d6" },
        "blue-dark": { "$value": "#3987e5" },
        "red-light": { "$value": "#e34948" },
        "red-dark": { "$value": "#e66767" },
        "violet-light": { "$value": "#6250d6" },
        "violet-dark": { "$value": "#9085e9" },
        "orange-light": { "$value": "#eb6834" },
        "orange-dark": { "$value": "#d95926" },
        "aqua-light": { "$value": "#1baf7a" },
        "aqua-dark": { "$value": "#199e70" },
        "yellow-light": { "$value": "#eda100" },
        "yellow-dark": { "$value": "#c98500" },
        "magenta-light": { "$value": "#e87ba4" },
        "magenta-dark": { "$value": "#d55181" }
      },
      "diff": {
        "added-bg-light": { "$value": "#e3f4e1" },
        "added-bg-dark": { "$value": "#173a22" },
        "removed-bg-light": { "$value": "#fbe6ea" },
        "removed-bg-dark": { "$value": "#45192a" },
        "added-word-light": { "$value": "#bfe6b9" },
        "added-word-dark": { "$value": "#24603a" },
        "removed-word-light": { "$value": "#f6c2cc" },
        "removed-word-dark": { "$value": "#7a2a45" },
        "hunk-bg-light": { "$value": "#eaf0fb" },
        "hunk-bg-dark": { "$value": "#1d2a40" }
      },
      "system-fallback": {
        "$description": "Approximate sRGB values of macOS system colors, for docs and mockups only. At runtime the app uses the named NSColor so Increase Contrast, accent color, and future OS changes apply automatically.",
        "window-light": { "$value": "#ececec" },
        "window-dark": { "$value": "#323232" },
        "content-light": { "$value": "#ffffff" },
        "content-dark": { "$value": "#1e1e1e" },
        "sidebar-light": { "$value": "#e8e8e8" },
        "sidebar-dark": { "$value": "#2a2a2a" },
        "label-light": { "$value": "#1d1d1f" },
        "label-dark": { "$value": "#e8e8e6" },
        "secondary-label-light": { "$value": "#6e6e73" },
        "secondary-label-dark": { "$value": "#a1a1a6" },
        "tertiary-label-light": { "$value": "#9a9a9f" },
        "tertiary-label-dark": { "$value": "#6e6e73" },
        "separator-light": { "$value": "#d9d9d9" },
        "separator-dark": { "$value": "#3d3d3d" },
        "accent-blue": { "$value": "#0a7aff" },
        "selection-light": { "$value": "#0a63d1" },
        "selection-dark": { "$value": "#0a5fc4" },
        "selection-inactive-light": { "$value": "#dcdcdc" },
        "selection-inactive-dark": { "$value": "#464646" }
      }
    }
  },
  "semantic": {
    "color": {
      "$type": "color",
      "surface": {
        "window": {
          "$value": "{primitive.color.system-fallback.window-light}",
          "$description": "Window background, toolbar, status bar.",
          "$extensions": { "io.github.kkdy21.overgrove": { "modes": { "dark": "{primitive.color.system-fallback.window-dark}" }, "appkit": "NSColor.windowBackgroundColor" } }
        },
        "content": {
          "$value": "{primitive.color.system-fallback.content-light}",
          "$description": "Graph pane and detail lists. All graph/status contrast was validated against this.",
          "$extensions": { "io.github.kkdy21.overgrove": { "modes": { "dark": "{primitive.color.system-fallback.content-dark}" }, "appkit": "NSColor.controlBackgroundColor" } }
        },
        "sidebar": {
          "$value": "{primitive.color.system-fallback.sidebar-light}",
          "$description": "Sidebar. Rendered with the system sidebar material, not a flat color; the hex is an approximation used for contrast checks.",
          "$extensions": { "io.github.kkdy21.overgrove": { "modes": { "dark": "{primitive.color.system-fallback.sidebar-dark}" }, "swiftui": "List(.sidebar) default background" } }
        },
        "selection": {
          "$value": "{primitive.color.system-fallback.selection-light}",
          "$description": "Selected row in the focused pane.",
          "$extensions": { "io.github.kkdy21.overgrove": { "modes": { "dark": "{primitive.color.system-fallback.selection-dark}" }, "appkit": "NSColor.selectedContentBackgroundColor" } }
        },
        "selection-inactive": {
          "$value": "{primitive.color.system-fallback.selection-inactive-light}",
          "$description": "Selected row in an unfocused pane.",
          "$extensions": { "io.github.kkdy21.overgrove": { "modes": { "dark": "{primitive.color.system-fallback.selection-inactive-dark}" }, "appkit": "NSColor.unemphasizedSelectedContentBackgroundColor" } }
        },
        "wip-row": {
          "$value": "#0a7aff14",
          "$description": "WIP row tint: accent color at 8% opacity over surface.content. Follows the user's accent color at runtime.",
          "$extensions": { "io.github.kkdy21.overgrove": { "modes": { "dark": "#0a7aff1f" }, "appkit": "NSColor.controlAccentColor.withAlphaComponent(0.08 light / 0.12 dark)" } }
        }
      },
      "text": {
        "primary": {
          "$value": "{primitive.color.system-fallback.label-light}",
          "$extensions": { "io.github.kkdy21.overgrove": { "modes": { "dark": "{primitive.color.system-fallback.label-dark}" }, "appkit": "NSColor.labelColor" } }
        },
        "secondary": {
          "$value": "{primitive.color.system-fallback.secondary-label-light}",
          "$description": "Metadata: author, relative date, path prefixes, counts.",
          "$extensions": { "io.github.kkdy21.overgrove": { "modes": { "dark": "{primitive.color.system-fallback.secondary-label-dark}" }, "appkit": "NSColor.secondaryLabelColor" } }
        },
        "tertiary": {
          "$value": "{primitive.color.system-fallback.tertiary-label-light}",
          "$description": "Placeholder and disabled text only. Never for information the user needs.",
          "$extensions": { "io.github.kkdy21.overgrove": { "modes": { "dark": "{primitive.color.system-fallback.tertiary-label-dark}" }, "appkit": "NSColor.tertiaryLabelColor" } }
        },
        "on-selection": {
          "$value": "#ffffff",
          "$description": "Text and status glyphs on a focused selection. Status glyphs switch to this color on selected rows; their shape still carries the meaning.",
          "$extensions": { "io.github.kkdy21.overgrove": { "modes": { "dark": "#ffffff" }, "appkit": "NSColor.alternateSelectedControlTextColor" } }
        },
        "link": {
          "$value": "#0a63d1",
          "$extensions": { "io.github.kkdy21.overgrove": { "modes": { "dark": "#4f9bf0" }, "appkit": "NSColor.linkColor" } }
        }
      },
      "border": {
        "separator": {
          "$value": "{primitive.color.system-fallback.separator-light}",
          "$extensions": { "io.github.kkdy21.overgrove": { "modes": { "dark": "{primitive.color.system-fallback.separator-dark}" }, "appkit": "NSColor.separatorColor" } }
        },
        "focus": {
          "$value": "{primitive.color.system-fallback.accent-blue}",
          "$extensions": { "io.github.kkdy21.overgrove": { "modes": { "dark": "{primitive.color.system-fallback.accent-blue}" }, "appkit": "NSColor.keyboardFocusIndicatorColor" } }
        }
      },
      "accent": {
        "$value": "{primitive.color.system-fallback.accent-blue}",
        "$description": "Interactive emphasis (focus ring, HEAD ring in the graph, primary button). Always the user's system accent color; the app never hard-codes a brand accent.",
        "$extensions": { "io.github.kkdy21.overgrove": { "modes": { "dark": "{primitive.color.system-fallback.accent-blue}" }, "appkit": "NSColor.controlAccentColor" } }
      },
      "status": {
        "$description": "Reserved state colors. Always paired with an SF Symbol and a text label (docs/design/iconography.md §5). Never reused for graph lanes or decoration.",
        "staged": {
          "$value": "{primitive.color.status.green-600}",
          "$extensions": { "io.github.kkdy21.overgrove": { "modes": { "dark": "{primitive.color.status.green-400}" } } }
        },
        "unstaged": {
          "$value": "{primitive.color.status.amber-600}",
          "$extensions": { "io.github.kkdy21.overgrove": { "modes": { "dark": "{primitive.color.status.amber-400}" } } }
        },
        "untracked": {
          "$value": "{primitive.color.status.neutral-600}",
          "$extensions": { "io.github.kkdy21.overgrove": { "modes": { "dark": "{primitive.color.status.neutral-400}" } } }
        },
        "conflicted": {
          "$value": "{primitive.color.status.crimson-600}",
          "$extensions": { "io.github.kkdy21.overgrove": { "modes": { "dark": "{primitive.color.status.crimson-400}" } } }
        },
        "ahead": {
          "$value": "{primitive.color.status.blue-600}",
          "$description": "Same step as behind on purpose: the arrow direction (↑/↓) is the encoding, the color only says 'differs from upstream'.",
          "$extensions": { "io.github.kkdy21.overgrove": { "modes": { "dark": "{primitive.color.status.blue-400}" } } }
        },
        "behind": {
          "$value": "{primitive.color.status.blue-600}",
          "$description": "Same step as ahead on purpose; see status.ahead.",
          "$extensions": { "io.github.kkdy21.overgrove": { "modes": { "dark": "{primitive.color.status.blue-400}" } } }
        },
        "locked": {
          "$value": "{primitive.color.status.neutral-600}",
          "$extensions": { "io.github.kkdy21.overgrove": { "modes": { "dark": "{primitive.color.status.neutral-400}" } } }
        },
        "prunable": {
          "$value": "{primitive.color.status.amber-600}",
          "$description": "Warning amber. Shares the unstaged step; the two never appear in the same context (worktree row vs file row).",
          "$extensions": { "io.github.kkdy21.overgrove": { "modes": { "dark": "{primitive.color.status.amber-400}" } } }
        },
        "ok": {
          "$value": "{primitive.color.status.green-600}",
          "$description": "Security checklist and onboarding checks that passed.",
          "$extensions": { "io.github.kkdy21.overgrove": { "modes": { "dark": "{primitive.color.status.green-400}" } } }
        },
        "warning": {
          "$value": "{primitive.color.status.amber-600}",
          "$description": "Onboarding and security checks that need attention, auth warnings.",
          "$extensions": { "io.github.kkdy21.overgrove": { "modes": { "dark": "{primitive.color.status.amber-400}" } } }
        },
        "error": {
          "$value": "{primitive.color.status.crimson-600}",
          "$description": "Failed commands, timeouts, checks that failed.",
          "$extensions": { "io.github.kkdy21.overgrove": { "modes": { "dark": "{primitive.color.status.crimson-400}" } } }
        }
      },
      "graph": {
        "lane": {
          "$description": "Lane colors in fixed cyclic order. Lane color index = lane column index mod 8, fixed when a lane is born (ADR-0010). Adjacent lanes always get consecutive slots, including 7→0 on wrap.",
          "0": { "$value": "{primitive.color.lane.green-light}", "$extensions": { "io.github.kkdy21.overgrove": { "modes": { "dark": "{primitive.color.lane.green-dark}" } } } },
          "1": { "$value": "{primitive.color.lane.blue-light}", "$extensions": { "io.github.kkdy21.overgrove": { "modes": { "dark": "{primitive.color.lane.blue-dark}" } } } },
          "2": { "$value": "{primitive.color.lane.red-light}", "$extensions": { "io.github.kkdy21.overgrove": { "modes": { "dark": "{primitive.color.lane.red-dark}" } } } },
          "3": { "$value": "{primitive.color.lane.violet-light}", "$extensions": { "io.github.kkdy21.overgrove": { "modes": { "dark": "{primitive.color.lane.violet-dark}" } } } },
          "4": { "$value": "{primitive.color.lane.orange-light}", "$extensions": { "io.github.kkdy21.overgrove": { "modes": { "dark": "{primitive.color.lane.orange-dark}" } } } },
          "5": { "$value": "{primitive.color.lane.aqua-light}", "$extensions": { "io.github.kkdy21.overgrove": { "modes": { "dark": "{primitive.color.lane.aqua-dark}" } } } },
          "6": { "$value": "{primitive.color.lane.yellow-light}", "$extensions": { "io.github.kkdy21.overgrove": { "modes": { "dark": "{primitive.color.lane.yellow-dark}" } } } },
          "7": { "$value": "{primitive.color.lane.magenta-light}", "$extensions": { "io.github.kkdy21.overgrove": { "modes": { "dark": "{primitive.color.lane.magenta-dark}" } } } }
        },
        "node-ring": {
          "$value": "{primitive.color.system-fallback.content-light}",
          "$description": "2px ring in the surface color around every node so nodes stay separate from edges that pass behind them.",
          "$extensions": { "io.github.kkdy21.overgrove": { "modes": { "dark": "{primitive.color.system-fallback.content-dark}" }, "appkit": "NSColor.controlBackgroundColor" } }
        },
        "head-ring": {
          "$value": "{semantic.color.accent}",
          "$description": "Extra ring on the commit checked out in the selected worktree."
        },
        "wip-node": {
          "$value": "{semantic.color.text.secondary}",
          "$description": "Hollow, dashed node for the WIP row. Never takes a lane color, so uncommitted work never looks like a commit."
        },
        "ref-pill-local-fill-opacity": {
          "$type": "number",
          "$value": 0.18,
          "$description": "Local branch pill = its lane color at this opacity, text in text.primary."
        },
        "ref-pill-remote-border-opacity": {
          "$type": "number",
          "$value": 0.6,
          "$description": "Remote branch pill = lane color outline at this opacity, no fill."
        }
      },
      "diff": {
        "added-bg": { "$value": "{primitive.color.diff.added-bg-light}", "$extensions": { "io.github.kkdy21.overgrove": { "modes": { "dark": "{primitive.color.diff.added-bg-dark}" } } } },
        "removed-bg": { "$value": "{primitive.color.diff.removed-bg-light}", "$extensions": { "io.github.kkdy21.overgrove": { "modes": { "dark": "{primitive.color.diff.removed-bg-dark}" } } } },
        "added-word-bg": { "$value": "{primitive.color.diff.added-word-light}", "$extensions": { "io.github.kkdy21.overgrove": { "modes": { "dark": "{primitive.color.diff.added-word-dark}" } } } },
        "removed-word-bg": { "$value": "{primitive.color.diff.removed-word-light}", "$extensions": { "io.github.kkdy21.overgrove": { "modes": { "dark": "{primitive.color.diff.removed-word-dark}" } } } },
        "hunk-header-bg": { "$value": "{primitive.color.diff.hunk-bg-light}", "$extensions": { "io.github.kkdy21.overgrove": { "modes": { "dark": "{primitive.color.diff.hunk-bg-dark}" } } } },
        "gutter-added": { "$value": "{semantic.color.status.staged}", "$description": "The '+' gutter glyph. The glyph, not the color, carries the meaning." },
        "gutter-removed": { "$value": "{semantic.color.status.conflicted}", "$description": "The '−' gutter glyph." }
      }
    },
    "spacing": {
      "$type": "dimension",
      "xxs": { "$value": "2px" },
      "xs": { "$value": "4px" },
      "sm": { "$value": "8px" },
      "md": { "$value": "12px" },
      "lg": { "$value": "16px" },
      "xl": { "$value": "24px" },
      "xxl": { "$value": "32px" }
    },
    "radius": {
      "$type": "dimension",
      "sm": { "$value": "4px", "$description": "Badges, ref pills" },
      "md": { "$value": "6px", "$description": "Buttons, text fields (matches system controls)" },
      "lg": { "$value": "10px", "$description": "Cards, popovers, onboarding steps" },
      "pill": { "$value": "999px" }
    },
    "typography": {
      "$type": "typography",
      "$description": "macOS text styles. Sizes are the macOS defaults; the app uses the SwiftUI text style, not the point size, so system changes apply.",
      "body": { "$value": { "fontFamily": "SF Pro", "fontSize": "13px", "fontWeight": 400, "lineHeight": 1.25 }, "$extensions": { "io.github.kkdy21.overgrove": { "swiftui": "Font.body" } } },
      "body-emphasized": { "$value": { "fontFamily": "SF Pro", "fontSize": "13px", "fontWeight": 600, "lineHeight": 1.25 }, "$extensions": { "io.github.kkdy21.overgrove": { "swiftui": "Font.body.weight(.semibold)" } } },
      "headline": { "$value": { "fontFamily": "SF Pro", "fontSize": "13px", "fontWeight": 700, "lineHeight": 1.25 }, "$extensions": { "io.github.kkdy21.overgrove": { "swiftui": "Font.headline" } } },
      "title": { "$value": { "fontFamily": "SF Pro", "fontSize": "15px", "fontWeight": 600, "lineHeight": 1.25 }, "$description": "Detail panel title (S-02 to S-05)", "$extensions": { "io.github.kkdy21.overgrove": { "swiftui": "Font.title3.weight(.semibold)" } } },
      "callout": { "$value": { "fontFamily": "SF Pro", "fontSize": "12px", "fontWeight": 400, "lineHeight": 1.25 }, "$extensions": { "io.github.kkdy21.overgrove": { "swiftui": "Font.callout" } } },
      "caption": { "$value": { "fontFamily": "SF Pro", "fontSize": "10px", "fontWeight": 400, "lineHeight": 1.2 }, "$description": "Status bar and sidebar section headers", "$extensions": { "io.github.kkdy21.overgrove": { "swiftui": "Font.caption" } } },
      "section-header": { "$value": { "fontFamily": "SF Pro", "fontSize": "11px", "fontWeight": 700, "lineHeight": 1.2 }, "$description": "Sidebar sections and detail groups (STAGED, UNSTAGED...). Uppercase is applied in the view.", "$extensions": { "io.github.kkdy21.overgrove": { "swiftui": "Font.subheadline.weight(.bold)" } } },
      "mono": { "$value": { "fontFamily": "SF Mono", "fontSize": "12px", "fontWeight": 400, "lineHeight": 1.35 }, "$description": "SHA, paths in the diff viewer, diff body", "$extensions": { "io.github.kkdy21.overgrove": { "swiftui": "Font.system(.callout, design: .monospaced)" } } },
      "mono-small": { "$value": { "fontFamily": "SF Mono", "fontSize": "11px", "fontWeight": 400, "lineHeight": 1.3 }, "$description": "Short SHA in graph rows", "$extensions": { "io.github.kkdy21.overgrove": { "swiftui": "Font.system(.subheadline, design: .monospaced)" } } }
    },
    "size": {
      "$type": "dimension",
      "row-sidebar": { "$value": "24px", "$description": "Follows the system sidebar icon size setting at runtime; 24px is the Medium default." },
      "row-graph": { "$value": "24px", "$description": "Commit row height. Fixed so the graph can be virtualized." },
      "row-file": { "$value": "22px" },
      "graph-lane-width": { "$value": "14px" },
      "graph-node": { "$value": "8px", "$description": "Commit node diameter (≥ 8px marker minimum)." },
      "graph-node-merge": { "$value": "6px", "$description": "Merge commit node: smaller, hollow." },
      "graph-node-head": { "$value": "10px" },
      "graph-edge": { "$value": "2px" },
      "graph-node-ring": { "$value": "2px" },
      "graph-max-lanes-visible": { "$type": "number", "$value": 12, "$description": "Beyond this the graph column scrolls horizontally inside its own area." },
      "symbol-small": { "$value": "12px" },
      "symbol-medium": { "$value": "14px" },
      "hit-target-min": { "$value": "20px", "$description": "Minimum click target for inline icon buttons." },
      "sidebar-width-min": { "$value": "200px" },
      "sidebar-width-ideal": { "$value": "240px" },
      "sidebar-width-max": { "$value": "360px" },
      "detail-width-min": { "$value": "280px" },
      "detail-width-ideal": { "$value": "340px" },
      "graph-width-min": { "$value": "420px" },
      "window-min-width": { "$value": "960px" },
      "window-min-height": { "$value": "600px" }
    },
    "motion": {
      "$description": "When Reduce Motion is on, replace movement with a cross-fade of duration-fast, or no animation.",
      "duration-fast": { "$type": "duration", "$value": "120ms", "$description": "Selection highlight, hover" },
      "duration-standard": { "$type": "duration", "$value": "200ms", "$description": "Panel content swap, disclosure" },
      "duration-slow": { "$type": "duration", "$value": "350ms", "$description": "Onboarding step transitions" },
      "easing-standard": { "$type": "cubicBezier", "$value": [0.2, 0.0, 0.0, 1.0] }
    },
    "opacity": {
      "$type": "number",
      "disabled": { "$value": 0.4 },
      "stale": { "$value": 0.6, "$description": "Data older than the last refresh while a refresh is running." }
    }
  }
}
