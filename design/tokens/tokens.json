          "io.github.kkdy21.overgrove": {
            "swiftui": "Font.largeTitle.weight(.bold)"
          }
        }
      },
      "body": { "$value": { "fontFamily": "SF Pro", "fontSize": "13px", "fontWeight": 400, "lineHeight": 1.25 }, "$extensions": { "io.github.kkdy21.overgrove": { "swiftui": "Font.body" } } },
      "body-emphasized": { "$value": { "fontFamily": "SF Pro", "fontSize": "13px", "fontWeight": 600, "lineHeight": 1.25 }, "$extensions": { "io.github.kkdy21.overgrove": { "swiftui": "Font.body.weight(.semibold)" } } },
      "headline": { "$value": { "fontFamily": "SF Pro", "fontSize": "13px", "fontWeight": 700, "lineHeight": 1.25 }, "$extensions": { "io.github.kkdy21.overgrove": { "swiftui": "Font.headline" } } },
      "title": {
        "$value": {
          "fontFamily": "SF Pro",
          "fontSize": "15px",
          "fontWeight": 600,
          "lineHeight": 1.25
        },
