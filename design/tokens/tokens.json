      "graph-width-min": { "$value": "480px" },
      "column-refs-ideal": { "$value": "172px", "$description": "Refs column; min 96px, max 280px." },
      "column-author-ideal": { "$value": "108px", "$description": "Min 72px, max 200px." },
      "column-date-ideal": { "$value": "52px", "$description": "Min 44px, max 120px." },
      "column-sha-ideal": { "$value": "72px", "$description": "Min 64px, max 96px." },
