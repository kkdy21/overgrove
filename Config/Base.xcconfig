// Project-wide build settings for Overgrove (applies to every target).
// Personal overrides (signing team, etc.) go in Config/Personal.xcconfig.local, which is git-ignored.
// See docs/README.md §2.1 and ADR-0003 / ADR-0006 / ADR-0008.

SDKROOT = macosx
SUPPORTED_PLATFORMS = macosx
MACOSX_DEPLOYMENT_TARGET = 14.0

// Swift 6 language mode with complete strict concurrency checking.
SWIFT_VERSION = 6.0
SWIFT_STRICT_CONCURRENCY = complete
SWIFT_TREAT_WARNINGS_AS_ERRORS = YES
GCC_TREAT_WARNINGS_AS_ERRORS = YES
SWIFT_EMIT_LOC_STRINGS = YES
LOCALIZATION_PREFERS_STRING_CATALOGS = YES

ALWAYS_SEARCH_USER_PATHS = NO
CLANG_ENABLE_MODULES = YES
CLANG_ENABLE_OBJC_ARC = YES
ENABLE_STRICT_OBJC_MSGSEND = YES
ENABLE_USER_SCRIPT_SANDBOXING = YES
DEAD_CODE_STRIPPING = YES
COPY_PHASE_STRIP = NO
ASSETCATALOG_COMPILER_GENERATE_SWIFT_ASSET_SYMBOL_EXTENSIONS = YES

// Debug / Release
ONLY_ACTIVE_ARCH[config=Debug] = YES
ENABLE_TESTABILITY[config=Debug] = YES
SWIFT_ACTIVE_COMPILATION_CONDITIONS[config=Debug] = DEBUG $(inherited)
SWIFT_OPTIMIZATION_LEVEL[config=Debug] = -Onone
SWIFT_OPTIMIZATION_LEVEL[config=Release] = -O
SWIFT_COMPILATION_MODE[config=Release] = wholemodule
GCC_OPTIMIZATION_LEVEL[config=Debug] = 0
DEBUG_INFORMATION_FORMAT[config=Debug] = dwarf
DEBUG_INFORMATION_FORMAT[config=Release] = dwarf-with-dsym

// Signing: "Sign to Run Locally" (ad-hoc). No team ID is committed (source-only distribution, N2).
CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY = -
DEVELOPMENT_TEAM =
// Hardened Runtime: Release builds are signed with `--options runtime` (verified with `codesign -dv`).
// Xcode turns it off for Debug so it can inject the test bundle and SwiftUI previews.
ENABLE_HARDENED_RUNTIME = YES

#include? "Personal.xcconfig.local"
