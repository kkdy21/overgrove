// Copy to Config/Personal.xcconfig.local (git-ignored) to override settings on your machine only.
// Never commit team IDs, certificates, or personal paths.
//
// Example: sign with your own Apple Development certificate instead of ad-hoc signing.
// CODE_SIGN_STYLE = Automatic
// DEVELOPMENT_TEAM = ABCDE12345
// CODE_SIGN_IDENTITY = Apple Development
//
// Example: let a tool attach to your own Release build (some Instruments templates need it). Release builds leave out
// `com.apple.security.get-task-allow` (#687); this puts it back on this machine only.
// CODE_SIGN_INJECT_BASE_ENTITLEMENTS = YES
