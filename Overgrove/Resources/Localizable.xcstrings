      }
    },
    "The folder of “%@” is missing or was replaced (%@). Restore it, or remove the repository from Overgrove." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%1$@”의 폴더가 없거나 바뀌었습니다(%2$@). 폴더를 되돌리거나 Overgrove에서 저장소를 제거하세요."
          }
        }
      }
    },
    "The folder you chose is a symbolic link." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "고른 폴더는 심볼릭 링크입니다."
          }
        }
      }
    },
    "The folder's path contains control characters (such as a line break), so Overgrove will not add it." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "폴더 경로에 제어 문자(줄바꿈 등)가 있어 Overgrove가 추가하지 않습니다."
          }
        }
      }
    },
    "The git chosen in Settings cannot be used" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "설정에서 고른 git을 사용할 수 없습니다"
          }
        }
      }
    },
    "The history of every worktree appears here." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 워크트리의 이력이 여기에 보입니다."
          }
        }
      }
    },
    "The only network action is git fetch. Nothing in your repositories is ever changed." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "네트워크 동작은 git fetch 하나뿐입니다. 저장소의 내용은 어떤 것도 바꾸지 않습니다."
          }
        }
      }
    },
    "The path goes through a symbolic link, so Overgrove does not follow it." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "경로가 심볼릭 링크를 거치므로 Overgrove가 따라가지 않습니다."
          }
        }
      }
    },
    "The path is not valid UTF-8, so Overgrove cannot pass it to git." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "경로가 올바른 UTF-8이 아니어서 Overgrove가 git에 넘길 수 없습니다."
          }
        }
      }
    },
    "The path leaves the worktree or is not a plain relative path." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "경로가 워크트리 밖으로 나가거나 단순한 상대 경로가 아닙니다."
          }
        }
      }
    },
    "The repository’s settings could not be checked." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "저장소 설정을 확인하지 못했습니다."
          }
        }
      }
    },
    "The submodule has no checkout here (git submodule update was not run)." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이곳에 서브모듈 체크아웃이 없습니다(git submodule update를 실행하지 않음)."
          }
        }
      }
    },
    "The worktree list could not be read, so this comparison may be out of date." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "워크트리 목록을 읽지 못해 이 비교는 최신이 아닐 수 있습니다."
          }
        }
      }
    },
    "This file" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 파일"
          }
        }
      }
    },
    "This file has no history yet" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 파일은 아직 이력이 없습니다"
          }
        }
      }
    },
    "This folder is a Git directory (such as .git) or a folder inside one, not a repository folder. Choose the repository or one of its worktrees; a bare repository (such as repo.git) can be chosen directly." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 폴더는 저장소 폴더가 아니라 Git 디렉터리(.git 등)이거나 그 안의 폴더입니다. 저장소나 그 워크트리를 고르세요. 베어 저장소(repo.git 등)는 직접 고를 수 있습니다."
          }
        }
      }
    },
    "This repository is marked untrusted." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 저장소는 신뢰하지 않음으로 표시되어 있습니다."
          }
        }
      }
    },
    "This repository lists more than %lld worktrees. Overgrove loads the changes of the first %lld." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 저장소에는 워크트리가 %1$lld개보다 많습니다. Overgrove는 처음 %2$lld개의 변경만 불러옵니다."
          }
        }
      }
    },
    "This repository lists more than %lld worktrees. Overgrove loads the status of the first %lld." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 저장소에는 워크트리가 %1$lld개보다 많습니다. Overgrove는 처음 %2$lld개의 상태만 불러옵니다."
          }
        }
      }
    },
    "This repository's Git settings point outside the folder you chose (for example core.worktree, or a .git file that points into another repository), so Overgrove will not add it." : {
      "localizations" : {
        "ko" : {
