#!/usr/bin/env bash
# Adds a `Refs: #<issue>` trailer derived from the branch name (<type>/<issue>-<slug>)
# unless the message already mentions that issue.
set -euo pipefail
msg_file="$1"
source="${2:-}"
case "$source" in merge|squash) exit 0 ;; esac

branch=$(git symbolic-ref --short -q HEAD || true)
issue=$(printf '%s' "$branch" | sed -nE 's#^(feat|fix|docs|test|chore|spike|refactor|perf|ci)/([0-9]+)-.*#\2#p')
[[ -n "$issue" ]] || exit 0

if grep -v '^#' "$msg_file" | grep -Eq "(^|[^0-9A-Za-z])#${issue}([^0-9]|$)"; then
  exit 0
fi
git interpret-trailers --in-place --if-exists addIfDifferent --trailer "Refs: #${issue}" "$msg_file"
