#!/usr/bin/env bash
# Overgrove pre-commit hook (installed by scripts/bootstrap.sh via core.hooksPath=.githooks)
#  1. Blocks direct commits on main (use a <type>/<issue>-<slug> branch).
#  2. Scans staged changes for secrets and personal paths with gitleaks (threat T18).
#  3. Blocks process/shell APIs in Swift files outside Overgrove/Execution/.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

branch=$(git symbolic-ref --short -q HEAD || true)
if [[ "$branch" == "main" && "${OVERGROVE_ALLOW_MAIN_COMMIT:-}" != "1" ]]; then
  echo "✋ Direct commits to main are not allowed. Create a branch: <type>/<issue>-<slug> (e.g. feat/12-worktree-list)." >&2
  exit 1
fi

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "✋ gitleaks is required for commits in this repository (brew install gitleaks)." >&2
  exit 1
fi
gitleaks git --pre-commit --staged --redact --no-banner --verbose --log-level warn .

staged_swift=()
while IFS= read -r -d '' f; do staged_swift+=("$f"); done < <(git diff --cached --name-only -z --diff-filter=ACMR -- '*.swift')
if [[ ${#staged_swift[@]} -gt 0 ]]; then
  scripts/lint/check-forbidden-apis.sh "${staged_swift[@]}"
fi
