#!/usr/bin/env bash
# Overgrove pre-push hook
#  1. Blocks direct pushes to main (the GitHub ruleset blocks them too).
#  2. Scans every commit about to be pushed with gitleaks (threat T18).
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "✋ gitleaks is required for pushes from this repository (brew install gitleaks)." >&2
  exit 1
fi

while read -r local_ref local_sha remote_ref remote_sha; do
  [[ "$local_sha" =~ ^0+$ ]] && continue   # branch deletion
  if [[ "$remote_ref" == "refs/heads/main" && "${OVERGROVE_ALLOW_MAIN_PUSH:-}" != "1" ]]; then
    echo "✋ Direct pushes to main are not allowed. Open a pull request." >&2
    exit 1
  fi
  if [[ "$remote_sha" =~ ^0+$ ]]; then
    log_opts="$local_sha --not --remotes"   # new branch: commits not yet on any remote-tracking ref
  else
    log_opts="$remote_sha..$local_sha"
  fi
  echo "gitleaks: scanning $local_ref ($log_opts)"
  gitleaks git --no-banner --redact --verbose --log-opts="$log_opts" .
done
